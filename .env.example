# Copy to .env for local development, or set these as environment
# variables on your hosting provider (Render dashboard / Vercel dashboard).

# --- Backend (Render) ---
# Port is provided by Render automatically; only set locally if needed.
PORT=5000
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Optional: shared room state + message history.
# Local: redis://localhost:6379/0
# Upstash (free tier, TLS): rediss://default:<password>@<host>:6379
REDIS_URL=
# Chat tuning
MAX_PARTICIPANTS_PER_ROOM=50
MAX_HISTORY=100
MAX_TEXT_LENGTH=2000
# Google OAuth (Render). Unset GOOGLE_CLIENT_ID for guest mode (local dev).
# Get the client ID from console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_CLIENT_ID=
# Secret for signing session JWTs. REQUIRED in production — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-only-change-me
# "auto" (default) = require sign-in iff GOOGLE_CLIENT_ID is set.
REQUIRE_AUTH=auto

# --- Frontend (Vercel) ---
# Public URL of the Render backend (no trailing slash).
VITE_SOCKET_URL=http://localhost:5000
